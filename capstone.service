# /etc/systemd/system/capstone.service  (Gunicorn = application tier)
[Unit]
Description=Capstone Flask API
After=network.target

[Service]
User=capstone
Group=capstone
WorkingDirectory=/opt/capstone/backend
EnvironmentFile=/etc/capstone.env
ExecStart=/opt/capstone/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 wsgi:app
Restart=always
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/log/capstone

[Install]
WantedBy=multi-user.target
